---
// Site footer shown at the bottom of every docs page, matching the homepage
// footer. Rendered by the PageFrame override below.
const ghHref = 'https://github.com/GStechschulte';
---

<div class="footer">
  <div class="footer-content">
    <span>Subject&nbsp;To</span>
    <span class="footer-dot" aria-hidden="true">·</span>
    <a href={ghHref} target="_blank" rel="noopener noreferrer">GitHub</a>
    <span class="footer-dot" aria-hidden="true">·</span>
    <a href="/blog/">Blog</a>
  </div>
</div>

<style>
  .footer {
    width: 100%;
    border-top: 1px solid var(--sl-color-hairline-shade);
    padding: var(--sl-nav-pad-y) var(--sl-nav-pad-x);
    background-color: var(--sl-color-bg-nav);
    margin-top: auto;
  }

  .footer-content {
    display: flex;
    gap: 0.75rem;
    align-items: center;
    justify-content: center;
    color: var(--sl-color-gray-3);
    font-variant: small-caps;
    letter-spacing: 0.03em;
  }

  .footer-content a {
    color: var(--sl-color-gray-3);
    text-decoration: none;
  }
  .footer-content a:hover { color: var(--sl-color-text-accent); }
  .footer-dot { color: var(--sl-color-hairline-shade); }
</style>
