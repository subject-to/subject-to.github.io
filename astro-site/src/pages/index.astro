---
// Standalone homepage — mirrors slatedb/website/src/pages/index.astro.
//
// Why standalone (not a Starlight splash page): slatedb builds its landing
// page as its own top-nav + footer document that bypasses the docs frame.
// That's the "navigation like slatedb" the design calls for. The docs and blog
// still render through Starlight; only `/` is bespoke.
//
// Tokens: this page uses the RAW material tokens from custom.css (--paper,
// --ink, --accent-mid, …) which live on plain :root, because Starlight's
// data-theme remaps don't reach a standalone src/pages/ route.

const pageTitle = "Subject To";
const description =
    "Subject To is a toolkit for solving sequential decision problems.";

// Core features — the slatedb "the engine" section. Each links into the docs.
const features = [
    {
        index: "I",
        name: "Develop",
        body: "Compose policies from a batteries-included SDK, or bring your own. Model the objective, the constraints, and the dynamics in plain Python.",
        href: "/docs/getting-started/introduction/",
    },
    {
        index: "II",
        name: "Simulate",
        body: "Run large-scale simulations to compare policies and stress-test what-if scenarios before anything touches production.",
        href: "/docs/tutorials/resource-allocation/",
    },
    {
        index: "III",
        name: "Deploy",
        body: "Ship policies to production, evaluate them against live traffic, and run shadow deployments to de-risk every rollout.",
        href: "/docs/getting-started/quick-start/",
    },
];

const docsHref = "/docs/getting-started/introduction/";
const ghHref = "https://github.com/GStechschulte";

import ThemeInit from "../components/ThemeInit.astro";
import ThemeToggle from "../components/ThemeToggle.astro";
import BrandMark from "../components/BrandMark.astro";
---

<!doctype html>
<!-- data-theme is set at runtime by ThemeInit (below), from the stored choice
     or the OS setting. The logo and palette both key off that attribute so
     they move together, and the header toggle can flip them. -->
<html lang="en">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <title>{pageTitle}</title>
        <meta name="description" content={description} />

        <!-- Pre-paint theme init (shared with docs + blog). Must precede styles. -->
        <ThemeInit />

        <!-- Same faces as the docs/blog (Starlight injects these there; here we
         must declare them ourselves — this page skips the Starlight frame). -->
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link
            rel="stylesheet"
            href="https://fonts.googleapis.com/css2?family=EB+Garamond:ital,wght@0,400;0,500;0,600;1,400;1,500&family=JetBrains+Mono:wght@400;500&display=swap"
        />
    </head>

    <body>
        <!-- 1. Top navigation — the slatedb header pattern. -->
        <header class="site-header">
            <a class="brand" href="/" aria-label="Subject To — home">
                <BrandMark class="brand-mark" />
                <span class="brand-name">subject&nbsp;to</span>
            </a>
            <nav class="header-links" aria-label="Primary">
                <a class="header-link" href={docsHref}>
                    docs
                </a>
                <a class="header-link" href="/blog/">
                    blog
                </a>
                <a
                    class="header-link"
                    href={ghHref}
                    target="_blank"
                    rel="noopener noreferrer"
                >
                    github
                </a>
                <ThemeToggle />
            </nav>
        </header>

        <main>
            <!-- 2. Hero — the cycling optimization statement + what it is. -->
            <section class="hero">
                <div class="hero-text">
                    <h1 class="hero-headline">
                        Decisions, made <em>optimal.</em>
                    </h1>
                    <p class="hero-sub">{description}</p>
                    <div class="hero-ctas">
                        <a class="cta cta-primary" href={docsHref}>
                            Read the docs
                        </a>
                        <a
                            class="cta cta-secondary"
                            href={ghHref}
                            target="_blank"
                            rel="noopener noreferrer"
                        >
                            GitHub
                        </a>
                    </div>
                </div>
            </section>

            <!-- 3. Lead — one paragraph of "what this is", slatedb's prose-lead. -->
            <section class="lead">
                <p class="lead-text">
                    To <strong>do</strong>.
                </p>
            </section>

            <!-- 4. Core features — slatedb's "the engine". Each card links to docs. -->
            <section class="features" aria-label="Core features">
                <h2 class="section-eyebrow">the workflow</h2>
                <div class="features-grid">
                    {features.map((f) => (
                        <a class="feature reveal" href={f.href}>
                            <span class="feature-index">{f.index}</span>
                            <h3 class="feature-name">{f.name}</h3>
                            <p class="feature-body">{f.body}</p>
                            <span class="feature-ref">
                                <span class="feature-ref-path">{f.href}</span>
                                <span
                                    class="feature-ref-arrow"
                                    aria-hidden="true"
                                >
                                    →
                                </span>
                            </span>
                        </a>
                    ))}
                </div>
            </section>

            <!-- 5. Closing CTA — slatedb's "Ready to build?". -->
            <section class="closing">
                <h2 class="closing-headline">Ready to model your problem?</h2>
                <p class="closing-sub">
                    The docs cover the SDK with a set of tutorials.
                </p>
                <div class="hero-ctas">
                    <a class="cta cta-primary" href={docsHref}>
                        Read the docs
                    </a>
                    <a
                        class="cta cta-secondary"
                        href={ghHref}
                        target="_blank"
                        rel="noopener noreferrer"
                    >
                        View on GitHub
                    </a>
                </div>
            </section>
        </main>

        <footer class="site-footer">
            <span>Subject&nbsp;To</span>
            <span class="footer-dot" aria-hidden="true">
                ·
            </span>
            <a href={ghHref} target="_blank" rel="noopener noreferrer">
                GitHub
            </a>
            <span class="footer-dot" aria-hidden="true">
                ·
            </span>
            <a href="/blog/">Blog</a>
        </footer>

        <script is:inline>
            // Reveal feature cards on scroll (matches the docs' motion vocabulary).
            const io = new IntersectionObserver(
                (entries) => {
                    for (const e of entries) {
                        if (e.isIntersecting) {
                            e.target.classList.add("is-visible");
                            io.unobserve(e.target);
                        }
                    }
                },
                { threshold: 0.15 },
            );
            document
                .querySelectorAll(".reveal")
                .forEach((el) => io.observe(el));
        </script>
        <style>
            /* Homepage-local layout. Colors come from the raw material tokens in
         custom.css (:root), so they resolve without the Starlight frame. */
            :root {
                --paper: #f4ebdd;
                --ink: #231f1a;
                --body-text: #2e2820;
                --muted: #857a66;
                --border: #d9ccb8;
                --hover-bg: #ece0cb;
                --accent-mid: #9c4f28;
                --accent-high: #7a3a1c;
                --font-serif:
                    "EB Garamond", ui-serif, Georgia, "Times New Roman", serif;
                --font-mono:
                    "JetBrains Mono", ui-monospace, SFMono-Regular, Menlo,
                    monospace;
            }

            /* Dark palette — driven by data-theme (set by ThemeInit / the toggle),
         mirroring the docs' dark ramp in custom.css. */
            :root[data-theme="dark"] {
                --paper: #1c1712;
                --ink: #ece1cf;
                --body-text: #ddd0ba;
                --muted: #6d6252;
                --border: #33291f;
                --hover-bg: #2a2118;
                --accent-mid: #d98a5c;
                --accent-high: #ece1cf;
            }

            :global(html) {
                background: var(--paper);
            }
            :global(body) {
                margin: 0;
                background: var(--paper);
                color: var(--body-text);
                font-family: var(--font-serif);
                line-height: 1.7;
                font-feature-settings:
                    "onum" 1,
                    "pnum" 1,
                    "kern" 1,
                    "liga" 1;
            }

            main {
                max-width: 60rem;
                margin: 0 auto;
                padding: 0 1.5rem;
            }

            /* ---- Top nav ---- */
            .site-header {
                max-width: 60rem;
                margin: 0 auto;
                padding: 1.5rem;
                display: flex;
                align-items: baseline;
                justify-content: space-between;
            }
            /* Icon + wordmark, slatedb-style. `color` feeds the currentColor glyph
         and the name together, so both flip with data-theme (ink ⇄ paper). */
            .brand {
                display: inline-flex;
                align-items: center;
                gap: 0.55rem;
                line-height: 0;
                color: var(--ink);
                text-decoration: none;
            }
            .brand-mark {
                height: 1.7rem;
                width: auto;
                display: block;
            }
            /* Wordmark: EB Garamond small-caps, weight 600, 0.02em tracking —
         canonical wordmark shared with the blog and docs headers. */
            .brand-name {
                font-family: var(--font-serif);
                font-size: 1.35rem;
                font-weight: 600;
                letter-spacing: 0.02em;
                line-height: 1;
                font-variant: small-caps;
                white-space: nowrap;
            }
            .header-links {
                display: flex;
                gap: 1.5rem;
            }
            .header-link {
                color: var(--muted);
                text-decoration: none;
                font-variant: small-caps;
                letter-spacing: 0.04em;
                font-size: 1.05rem;
                transition: color 0.15s ease;
            }
            .header-link:hover {
                color: var(--accent-mid);
            }

            /* ---- Hero ---- */
            .hero {
                padding: 5rem 0 3rem;
            }
            @media (max-width: 46rem) {
                .hero {
                    padding: 3rem 0;
                }
            }
            .hero-headline {
                font-size: clamp(2.4rem, 6vw, 3.6rem);
                line-height: 1.1;
                font-weight: 600;
                color: var(--ink);
                margin: 0 0 1rem;
            }
            .hero-headline em {
                color: var(--accent-mid);
                font-style: italic;
            }
            .hero-sub {
                font-size: 1.2rem;
                color: var(--body-text);
                max-width: 30rem;
                margin: 0 0 1.75rem;
            }
            .hero-ctas {
                display: flex;
                gap: 0.9rem;
                flex-wrap: wrap;
            }
            .cta {
                display: inline-block;
                padding: 0.55rem 1.3rem;
                border-radius: 6px;
                text-decoration: none;
                font-size: 1.05rem;
                font-variant: small-caps;
                letter-spacing: 0.03em;
                border: 1px solid var(--border);
                transition:
                    background 0.15s ease,
                    color 0.15s ease;
            }
            .cta-primary {
                background: var(--accent-mid);
                color: var(--paper);
                border-color: var(--accent-mid);
            }
            .cta-primary:hover {
                background: var(--accent-high);
                border-color: var(--accent-high);
            }
            .cta-secondary {
                background: transparent;
                color: var(--ink);
            }
            .cta-secondary:hover {
                background: var(--hover-bg);
            }

            /* ---- Lead ---- */
            .lead {
                padding: 2rem 0;
                border-top: 1px solid var(--border);
            }
            .lead-text {
                font-size: 1.35rem;
                line-height: 1.6;
                color: var(--body-text);
                max-width: 46rem;
            }
            .lead-text strong {
                color: var(--ink);
                font-weight: 600;
            }

            /* ---- Features ---- */
            .features {
                padding: 2rem 0 3rem;
                border-top: 1px solid var(--border);
            }
            .section-eyebrow {
                font-variant: small-caps;
                letter-spacing: 0.08em;
                color: var(--muted);
                font-size: 1rem;
                font-weight: 500;
                margin: 0 0 1.5rem;
            }
            .features-grid {
                display: grid;
                grid-template-columns: repeat(3, 1fr);
                gap: 1.25rem;
            }
            @media (max-width: 46rem) {
                .features-grid {
                    grid-template-columns: 1fr;
                }
            }
            .feature {
                display: block;
                padding: 1.5rem;
                border: 1px solid var(--border);
                border-radius: 10px;
                text-decoration: none;
                color: var(--body-text);
                transition:
                    background 0.15s ease,
                    border-color 0.15s ease,
                    transform 0.15s ease;
            }
            .feature:hover {
                background: var(--hover-bg);
                border-color: var(--accent-mid);
                transform: translateY(-2px);
            }
            .feature-index {
                font-family: var(--font-mono);
                color: var(--accent-mid);
                font-size: 0.9rem;
            }
            .feature-name {
                font-size: 1.5rem;
                font-weight: 600;
                color: var(--ink);
                margin: 0.3rem 0 0.6rem;
                font-variant: small-caps;
                letter-spacing: 0.03em;
            }
            .feature-body {
                margin: 0 0 1rem;
                font-size: 1.05rem;
            }
            .feature-ref {
                display: flex;
                align-items: center;
                gap: 0.4rem;
                font-family: var(--font-mono);
                font-size: 0.8rem;
                color: var(--muted);
            }
            .feature:hover .feature-ref {
                color: var(--accent-mid);
            }

            /* ---- Closing ---- */
            .closing {
                padding: 4rem 0;
                border-top: 1px solid var(--border);
                text-align: center;
            }
            .closing-headline {
                font-size: clamp(1.8rem, 4vw, 2.6rem);
                font-weight: 600;
                color: var(--ink);
                margin: 0 0 0.75rem;
            }
            .closing-sub {
                color: var(--body-text);
                font-size: 1.15rem;
                margin: 0 0 1.75rem;
            }
            .closing .hero-ctas {
                justify-content: center;
            }

            /* ---- Footer ---- */
            .site-footer {
                max-width: 60rem;
                margin: 0 auto;
                padding: 2rem 1.5rem 3rem;
                border-top: 1px solid var(--border);
                display: flex;
                align-items: center;
                gap: 0.75rem;
                color: var(--muted);
                font-variant: small-caps;
                letter-spacing: 0.03em;
            }
            .site-footer a {
                color: var(--muted);
                text-decoration: none;
            }
            .site-footer a:hover {
                color: var(--accent-mid);
            }
            .footer-dot {
                color: var(--border);
            }

            /* Scroll-reveal */
            .reveal {
                opacity: 0;
                transform: translateY(24px);
                transition:
                    opacity 0.6s ease,
                    transform 0.6s ease;
            }
            .reveal.is-visible {
                opacity: 1;
                transform: none;
            }
            @media (prefers-reduced-motion: reduce) {
                .reveal {
                    opacity: 1;
                    transform: none;
                    transition: none;
                }
            }
        </style>
    </body>
</html>
