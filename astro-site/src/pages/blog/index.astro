---
// Blog index — a table-of-contents list of posts (numeral · title · date · →),
// mirroring slatedb/website/src/pages/blog/index.astro.
import { getCollection } from 'astro:content';
import Blog from '../../layouts/Blog.astro';
import { slugifyTag } from '../../lib/tags';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime(),
);

const fmt = (d: Date) =>
  d.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric', timeZone: 'UTC' });

// Roman numerals for the hanging index gutter.
const roman = (n: number): string => {
  const map: [number, string][] = [[10, 'X'], [9, 'IX'], [5, 'V'], [4, 'IV'], [1, 'I']];
  let out = '';
  for (const [v, s] of map) {
    while (n >= v) { out += s; n -= v; }
  }
  return out;
};
---

<Blog title="Blog — Subject To" description="Notes, releases, and writing from the Subject To project.">
  <div class="index">
    <section class="group">
      <h2 class="group-label">Blog</h2>
      <div class="group-meta">
        <span class="group-count">{posts.length} {posts.length === 1 ? 'post' : 'posts'}</span>
        <a class="group-rss" href="/blog/rss.xml">rss</a>
      </div>
      {posts.length === 0 ? (
        <p class="empty">No posts yet.</p>
      ) : (
        <ul class="rows">
          {posts.map((post, i) => (
            <li>
              <a class="row" href={`/blog/${post.id}/`}>
                <span class="row-num">{roman(i + 1)}</span>
                <span class="row-title">{post.data.title}</span>
                <time class="row-date" datetime={post.data.pubDate.toISOString()}>{fmt(post.data.pubDate)}</time>
                <span class="row-arrow" aria-hidden="true">→</span>
              </a>
              {post.data.tags.length > 0 && (
                <div class="row-tags">
                  {post.data.tags.map((tag) => (
                    <a class="tag-chip" href={`/blog/tags/${slugifyTag(tag)}/`}>{tag}</a>
                  ))}
                </div>
              )}
            </li>
          ))}
        </ul>
      )}
    </section>
  </div>
</Blog>

<style>
  .index { max-width: 44rem; margin: 0 auto; padding: 4rem 0 2rem; }
  .group { position: relative; }

  /* Mono labels straddling the ruled divider — left = section, right = count + rss. */
  .group-label,
  .group-meta {
    position: absolute;
    top: -0.6rem;
    background-color: var(--paper);
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    line-height: 1.2;
  }
  .group-label { left: 0; margin: 0; padding: 0 0.6rem 0 0; font-weight: 500; color: var(--muted); }
  .group-meta {
    right: 0;
    display: flex;
    align-items: center;
    gap: 0.85rem;
    padding: 0 0 0 0.6rem;
    color: var(--muted);
  }
  .group-rss { color: var(--accent-mid); text-decoration: none; transition: color 0.15s ease; }
  .group-rss:hover { color: var(--accent-high); }

  .rows { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--border); }
  .rows li { border-bottom: 1px solid var(--border); }
  .row {
    display: flex;
    align-items: baseline;
    padding: 0.85rem 0.25rem 0.35rem 0;
    text-decoration: none;
  }

  /* Tag chips sit below each row, indented past the numeral gutter. Kept as
     sibling links (not nested in the row anchor) to avoid invalid nested <a>. */
  .row-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    padding: 0 0 0.85rem 2.25rem;
  }
  .tag-chip {
    font-family: var(--font-mono);
    font-size: 0.66rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--muted);
    text-decoration: none;
    padding: 0.12rem 0.5rem;
    border: 1px solid var(--border);
    border-radius: 999px;
    transition: color 0.15s ease, border-color 0.15s ease, background 0.15s ease;
  }
  .tag-chip:hover { color: var(--accent-mid); border-color: var(--accent-mid); background: var(--hover-bg); }
  .row-num {
    flex: 0 0 2.25rem;
    font-family: var(--font-mono);
    font-size: 0.85rem;
    letter-spacing: 0.06em;
    color: var(--muted);
    transition: color 0.15s ease;
  }
  .row-title {
    flex: 0 1 auto;
    font-size: 1.3rem;
    line-height: 1.3;
    color: var(--ink);
    min-width: 0;
    transition: color 0.15s ease;
  }
  .row-date {
    flex: 0 0 auto;
    margin-left: auto;
    padding-left: 1.5rem;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--muted);
    white-space: nowrap;
    transition: color 0.15s ease;
  }
  .row-arrow {
    flex: 0 0 auto;
    margin-left: 0.85rem;
    color: var(--muted);
    font-size: 0.95rem;
    transition: transform 0.15s ease, color 0.15s ease;
  }
  .row:hover .row-num { color: var(--accent-mid); }
  .row:hover .row-title { color: var(--accent-high); }
  .row:hover .row-date { color: var(--accent-mid); }
  .row:hover .row-arrow { color: var(--accent-mid); transform: translateX(0.3rem); }

  .empty { color: var(--muted); font-style: italic; }

  @media (max-width: 560px) {
    .row-num { flex-basis: 1.75rem; }
    .row-title { font-size: 1.15rem; }
  }
</style>
