---
// Individual blog post — mirrors slatedb/website/src/pages/blog/[...slug].astro.
// Back-link · title · meta (date · author) · rendered body · back-link.
import { getCollection, render } from 'astro:content';
import Blog from '../../layouts/Blog.astro';
import { slugifyTag } from '../../lib/tags';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const { title, author, authorGithub, pubDate, description, tags } = post.data;

const dateLabel = pubDate.toLocaleDateString('en-US', {
  year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC',
});
const isoDate = pubDate.toISOString();
---

<Blog title={`${title} — Subject To`} description={description}>
  <article class="post">
    <header class="post-head">
      <a class="post-back" href="/blog/">← all posts</a>
      <h1 class="post-title">{title}</h1>
      <div class="post-meta">
        <time datetime={isoDate}>{dateLabel}</time>
        <span class="post-meta-sep" aria-hidden="true">·</span>
        {authorGithub ? (
          <a href={`https://github.com/${authorGithub}`} target="_blank" rel="noopener noreferrer">{author}</a>
        ) : (
          <span>{author}</span>
        )}
      </div>
      {tags.length > 0 && (
        <div class="post-tags">
          {tags.map((tag) => (
            <a class="tag-chip" href={`/blog/tags/${slugifyTag(tag)}/`}>{tag}</a>
          ))}
        </div>
      )}
    </header>

    <div class="post-body">
      <Content />
    </div>

    <footer class="post-foot">
      <a class="post-back" href="/blog/">← all posts</a>
    </footer>
  </article>
</Blog>

<script>
  // Deep-link each section heading (pure enhancement; ids already exist).
  for (const h of document.querySelectorAll<HTMLElement>(
    '.post-body h2[id], .post-body h3[id], .post-body h4[id]',
  )) {
    const a = document.createElement('a');
    a.className = 'heading-anchor';
    a.href = `#${h.id}`;
    a.textContent = '#';
    a.setAttribute('aria-label', `Link to ${h.textContent?.trim()}`);
    h.appendChild(a);
  }
  // External links open in a new tab.
  for (const link of document.querySelectorAll<HTMLAnchorElement>('.post-body a[href^="http"]')) {
    link.target = '_blank';
    link.rel = 'noopener noreferrer';
  }
</script>

<style>
  .post { max-width: 44rem; margin: 0 auto; padding: 3rem 0 2rem; }

  .post-back {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--muted);
    text-decoration: none;
    transition: color 0.15s ease;
  }
  .post-back:hover { color: var(--accent-mid); }

  .post-head { margin: 1.5rem 0 2.5rem; }
  .post-title {
    font-size: clamp(2rem, 5vw, 3rem);
    line-height: 1.15;
    font-weight: 600;
    color: var(--ink);
    margin: 1rem 0 0.75rem;
  }
  .post-meta {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--muted);
    display: flex;
    gap: 0.6rem;
    align-items: center;
  }
  .post-meta a { color: var(--muted); text-decoration: none; }
  .post-meta a:hover { color: var(--accent-mid); }
  .post-meta-sep { color: var(--border); }

  .post-tags { display: flex; flex-wrap: wrap; gap: 0.4rem; margin-top: 0.9rem; }
  .tag-chip {
    font-family: var(--font-mono);
    font-size: 0.66rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--muted);
    text-decoration: none;
    padding: 0.14rem 0.55rem;
    border: 1px solid var(--border);
    border-radius: 999px;
    transition: color 0.15s ease, border-color 0.15s ease, background 0.15s ease;
  }
  .tag-chip:hover { color: var(--accent-mid); border-color: var(--accent-mid); background: var(--hover-bg); }

  /* ---- Prose ---- */
  .post-body { font-size: 1.2rem; color: var(--body-text); }

  /* Drop capital on the opening paragraph only — mirrors gstechschulte.github.io.
     Guarded to a <p> that is the first child, so posts opening with a
     heading, list, or image are left untouched. */
  .post-body :global(> p:first-child::first-letter) {
    float: left;
    font-family: var(--font-serif);
    font-size: 3.4em;
    line-height: 0.78;
    font-weight: 500;
    color: var(--ink);
    padding: 0.02em 0.09em 0 0;
    margin-top: 0.02em;
  }
  .post-body :global(h2),
  .post-body :global(h3),
  .post-body :global(h4) {
    color: var(--ink);
    font-weight: 600;
    font-variant: small-caps;
    letter-spacing: 0.04em;
    line-height: 1.2;
    margin: 2.5rem 0 0.75rem;
  }
  .post-body :global(h2) { font-size: 1.7rem; }
  .post-body :global(h3) { font-size: 1.4rem; }
  .post-body :global(p) { margin: 0 0 1.25rem; }
  .post-body :global(a) { color: var(--accent-mid); text-underline-offset: 2px; }
  .post-body :global(a:hover) { color: var(--accent-high); }
  .post-body :global(strong) { color: var(--ink); font-weight: 600; }
  .post-body :global(blockquote) {
    margin: 1.5rem 0;
    padding-left: 1.2rem;
    border-left: 3px solid var(--accent-mid);
    color: var(--muted);
    font-style: italic;
  }
  .post-body :global(code) {
    font-family: var(--font-mono);
    font-size: 0.88em;
    background: var(--hover-bg);
    padding: 0.1em 0.35em;
    border-radius: 4px;
  }
  .post-body :global(pre) {
    font-family: var(--font-mono);
    font-size: 0.9rem;
    line-height: 1.6;
    padding: 1.1rem 1.25rem;
    border: 1px solid var(--border);
    border-radius: 8px;
    overflow-x: auto;
  }
  .post-body :global(pre code) { background: none; padding: 0; }
  .post-body :global(img) { max-width: 100%; border-radius: 8px; }
  .post-body :global(ul),
  .post-body :global(ol) { margin: 0 0 1.25rem; padding-left: 1.4rem; }
  .post-body :global(li) { margin: 0.3rem 0; }

  /* Heading anchor added by the script above. */
  .post-body :global(.heading-anchor) {
    margin-left: 0.4rem;
    color: var(--border);
    text-decoration: none;
    opacity: 0;
    transition: opacity 0.15s ease;
  }
  .post-body :global(h2:hover .heading-anchor),
  .post-body :global(h3:hover .heading-anchor),
  .post-body :global(h4:hover .heading-anchor) { opacity: 1; }

  .post-foot { margin-top: 3rem; padding-top: 1.5rem; border-top: 1px solid var(--border); }
</style>
